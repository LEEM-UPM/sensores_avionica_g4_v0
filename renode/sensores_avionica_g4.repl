sysbus:
    init:
        Tag <0x90000000 0x10000000> "quadspi"
        Tag <0x48000000 0x2000> "pinctrl"
        Tag <0x4000a400 0x9f0> "fdcan1 / fdcan2 / fdcan3"
        Tag <0x1fff7000 0x400> "st_nvm_user_otp"
        Tag <0x40000000 0x400> "timers2"
        Tag <0x40000400 0x400> "timers3"
        Tag <0x40000800 0x400> "timers4"
        Tag <0x40000c00 0x400> "timers5"
        Tag <0x40001000 0x400> "timers6"
        Tag <0x40001400 0x400> "timers7"
        Tag <0x40002c00 0x400> "wwdg"
        Tag <0x40003000 0x400> "iwdg"
        Tag <0x40003800 0x400> "spi2"
        Tag <0x40003c00 0x400> "spi3"
        Tag <0x40004800 0x400> "usart3"
        Tag <0x40004c00 0x400> "uart4"
        Tag <0x40005000 0x400> "uart5"
        Tag <0x40005c00 0x400> "usb"
        Tag <0x40006400 0x400> "fdcan1"
        Tag <0x40006800 0x400> "fdcan2"
        Tag <0x40006c00 0x400> "fdcan3"
        Tag <0x40007c00 0x400> "lptim1"
        Tag <0x4000a000 0x400> "ucpd1"
        Tag <0x40010400 0x400> "exti"
        Tag <0x40012c00 0x400> "timers1"
        Tag <0x40013000 0x400> "spi1"
        Tag <0x40013400 0x400> "timers8"
        Tag <0x40013c00 0x400> "spi4"
        Tag <0x40014000 0x400> "timers15"
        Tag <0x40014400 0x400> "timers16"
        Tag <0x40014800 0x400> "timers17"
        Tag <0x40015000 0x400> "timers20"
        Tag <0x40015400 0x400> "sai1 / sai1_a / sai1_b"
        Tag <0x40020000 0x400> "dma1"
        Tag <0x40020400 0x400> "dma2"
        Tag <0x40020800 0x400> "dmamux1"
        Tag <0x40022000 0x400> "flash"
        Tag <0x40023000 0x400> "crc"
        Tag <0x50000800 0x400> "dac1"
        Tag <0x50000c00 0x400> "dac2"
        Tag <0x50001000 0x400> "dac3"
        Tag <0x50001400 0x400> "dac4"
        Tag <0x50060800 0x400> "rng"
        Tag <0xa0001000 0x400> "quadspi"
        Tag <0x1fff7500 0x300> "flash@1fff7500"
        Tag <0x50000000 0x100> "adc1"
        Tag <0x50000100 0x100> "adc2"
        Tag <0x50000400 0x100> "adc3"
        Tag <0x50000500 0x100> "adc4"
        Tag <0x50000600 0x100> "adc5"
        Tag <0x40010300 0x20> "opamp1 / opamp2 / opamp3"
        Tag <0xe000e010 0x10> "systick"
        Tag <0x40010200 0x4> "comp1"
        Tag <0x40010204 0x4> "comp2"
        Tag <0x40010208 0x4> "comp3"
        Tag <0x4001020c 0x4> "comp4"
        Tag <0x40010210 0x4> "comp5"
        Tag <0x40010214 0x4> "comp6"
        Tag <0x40010218 0x4> "comp7"
        Tag <0xa8 0x2> "ts_cal1_otp"
        Tag <0xaa 0x2> "vrefint_otp"
        Tag <0xca 0x2> "ts_cal2_otp"

clk_lse: Python.PythonPeripheral @ sysbus 0x40007000
    size: 0x4
    initable: true
    filename: "scripts/pydev/rolling-bit.py"

gpioa: GPIOPort.STM32_GPIOPort @ sysbus <0x48000000, +0x400>

gpiob: GPIOPort.STM32_GPIOPort @ sysbus <0x48000400, +0x400>

gpioc: GPIOPort.STM32_GPIOPort @ sysbus <0x48000800, +0x400>

gpiod: GPIOPort.STM32_GPIOPort @ sysbus <0x48000c00, +0x400>

gpioe: GPIOPort.STM32_GPIOPort @ sysbus <0x48001000, +0x400>

gpiof: GPIOPort.STM32_GPIOPort @ sysbus <0x48001400, +0x400>

gpiog: GPIOPort.STM32_GPIOPort @ sysbus <0x48001800, +0x400>

flash0: Memory.MappedMemory @ sysbus 0x8000000
    size: 0x80000

sram0: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x20000

ccm_sram: Memory.MappedMemory @ sysbus 0x10000000
    size: 0x8000

// autogenerated

nvic0: IRQControllers.NVIC @ {
    sysbus new Bus.BusPointRegistration { address: 0xe000e000; cpu: cpu0 }
}
    -> cpu0@0
    systickFrequency: 160000000

cpu0: CPU.CortexM @ sysbus
    cpuType: "cortex-m4f"
    nvic: nvic0

ledcan1: Miscellaneous.LED @ gpioc 0xd

gpioc:
    13 -> ledcan1@0

ledcan2: Miscellaneous.LED @ gpiob 0x7

gpiob:
    7 -> ledcan2@0

ledcan3: Miscellaneous.LED @ gpioa 0xf

gpioa:
    15 -> ledcan3@0

ledstat: Miscellaneous.LED @ gpioa 0x5

gpioa:
    5 -> ledstat@0

rtc: Timers.STM32F4_RTC @ sysbus 0x40002800
    AlarmIRQ->nvic0@41

rcc: Python.PythonPeripheral @ sysbus 0x40021000
    size: 0x400
    initable: true
    filename: "scripts/pydev/flipflop.py"

// cortex-m overlay

dwt: Miscellaneous.DWT @ sysbus 0xE0001000
    frequency: 72000000

// st,stm32g4 overlay




// ==========================================
// Replaced Tags with Actual Peripherals
// ==========================================
i2c1: I2C.STM32F7_I2C @ sysbus 0x40005400
i2c2: I2C.STM32F7_I2C @ sysbus 0x40005800
i2c3: I2C.STM32F7_I2C @ sysbus 0x40007800
i2c4: I2C.STM32F7_I2C @ sysbus 0x40008400

usart1: UART.STM32F7_USART @ sysbus 0x40013800
    frequency: 170000000
usart2: UART.STM32F7_USART @ sysbus 0x40004400
    frequency: 170000000
lpuart1: UART.STM32F7_USART @ sysbus 0x40008000
    frequency: 170000000

// ==========================================
// Sensores I2C
// ==========================================

// IMU 1 en I2C1 (PB7/PB8)
// REAL: WSEN-ISDS (Wurth)
imu1: Sensors.WSEN_ISDS @ i2c1 0x6A
    IRQ -> gpioc@14

// Magnetómetro en I2C1
// REAL: MLX90393 (Melexis)
mag: Sensors.MLX90393 @ i2c1 0x0C
    IRQ -> gpioc@13

// Barómetro 1 en I2C1
// REAL: WSEN-PADS (Wurth)
baro1: Sensors.WSEN_PADS @ i2c1 0x5C

// Sensor de humedad en I2C1
// REAL: WSEN-HIDS (Wurth)
hids: Sensors.WSEN_HIDS @ i2c1 0x5F

// IMU 2 en I2C2 (PA8/PA9)
// REAL: LSM6DSV32XTR (ST)
imu2: Sensors.LSM6DSV32XTR @ i2c2 0x6B
    IRQ -> gpioa@10

// Barómetro 2 en I2C2
// REAL: WSEN-PADS (Wurth)
baro2: Sensors.WSEN_PADS @ i2c2 0x5D
